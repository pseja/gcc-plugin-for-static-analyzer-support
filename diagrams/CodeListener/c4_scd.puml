@startuml c4_scd
!include <C4/C4_Container>

title CodeListener System Context Diagram (C4 Level 1)

Person(developer, "C/C++ Developer", "Writes system-level C code that manipulates pointers, linked lists, and low-level memory")

' https://www.fit.vut.cz/research/group/verifit/public/tools/code-listener/
System(codelistener, "CodeListener", "Infrastructure for building static analysis tools")

' https://en.wikipedia.org/wiki/Build_automation
' https://en.wikipedia.org/wiki/Build_automation#cite_note-2
System_Ext(build_system, "Build System", "A tool or set of tools that automate the compilation and linking of source code into an executable program or library.")
' https://gcc.gnu.org/
System_Ext(gcc, "GCC", "GNU Compiler Collection")
' https://llvm.org/
System_Ext(llvm, "LLVM", "LLVM Compiler Infrastructure")
' https://www.fit.vut.cz/research/group/verifit/public/tools/predator/
System_Ext(predator, "Predator Analyzer", "Tool for automated formal verification of sequential C programs operating with pointers and linked lists")

Rel(developer, build_system, "Builds project via", "GNU Make and CMake")
Rel(build_system, gcc, "Invokes GCC to compile code", "gcc -fplugin=libsl.so ...")
' https://clang.llvm.org/
Rel(build_system, llvm, "Invokes Clang to compile code", "clang -Xclang -load -Xclang libsl.so -g ...")

Rel(gcc, codelistener, "Executes plugin with access to GIMPLE IR via", "plugin callback / pass API")
Rel(llvm, codelistener, "Executes pass with access to LLVM IR via", "LLVM pass infrastructure")

Rel(codelistener, predator, "Provides normalized IR to", "CodeStorage::Storage")
Rel(predator, developer, "Reports verification results to", "Error logs, warnings, memory leak alerts")

note right of codelistener
    Optional outputs:
    - Control Flow Graph
    - Debug Location Traces
    - Pretty-Printed Code
    - Type Dependency Graph
end note

SHOW_LEGEND()
@enduml